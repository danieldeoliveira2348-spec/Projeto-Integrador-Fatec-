        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    subgraph Cliente [\&quot;Cliente / Usuário\&quot;]\n        Start((Início)) --&gt; T1[\&quot;Solicitar Agendamento e Selecionar Corte\&quot;]\n        T1 --&gt; Msg1[[\&quot;Enviar Solicitação\&quot;]]\n        Msg2[[\&quot;Receber Resposta\&quot;]] --&gt; End((Fim))\n    end\n\n    subgraph Sistema [\&quot;Sistema (King&#39;s Barber)\&quot;]\n        Msg1 --&gt; T2[\&quot;Conferir Dados e Disponibilidade\&quot;]\n        T2 --&gt; GW1{\&quot;Dados completos e Horário livre?\&quot;}\n        GW1 -- Não --&gt; T3[\&quot;Solicitar Correção / Outra Hora\&quot;]\n        T3 --&gt; Msg2\n        GW1 -- Sim --&gt; T4[\&quot;Encaminhar Reserva Pendente\&quot;]\n        T4 --&gt; Msg4[[\&quot;Enviar para o Barbeiro\&quot;]]\n        Msg5[[\&quot;Receber Status\&quot;]] --&gt; T5[\&quot;Notificar Resultado ao Cliente\&quot;]\n        T5 --&gt; Msg2\n    end\n\n    subgraph Barbeiro [\&quot;Barbeiro\&quot;]\n        Msg4 --&gt; T6[\&quot;Receber Reserva\&quot;]\n        T6 --&gt; GW2{\&quot;Aceitar Agendamento?\&quot;}\n        GW2 -- Não --&gt; T7[\&quot;Informar Motivo da Recusa\&quot;]\n        T7 --&gt; Msg5\n        GW2 -- Sim --&gt; T8[\&quot;Enviar ao Banco de Dados\&quot;]\n        T8 --&gt; Msg6[[\&quot;Enviar Transação\&quot;]]\n    end\n\n    subgraph Banco [\&quot;Banco de Dados (SGBDR)\&quot;]\n        Msg6 --&gt; T9[\&quot;Conferir Dados e Concorrência (ACID)\&quot;]\n        T9 --&gt; GW3{\&quot;Pagamento e Transação Aceitos?\&quot;}\n        GW3 -- Não --&gt; T10[\&quot;Informar Pagamento Pendente / Inválido\&quot;]\n        T10 --&gt; Msg5\n        GW3 -- Sim --&gt; T11[\&quot;Registrar Informação no MySQL\&quot;]\n        T11 --&gt; T12[\&quot;Informar Pagamento Efetuado com Sucesso\&quot;]\n        T12 --&gt; Msg5\n    end\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Uwgikcc_i2zQ3Mh-bR89-1">
